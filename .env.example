# Copy this file to ".env" and put your real key in .env
# .env is ignored by git: it must never be published.

# Model provider (OpenAI-compatible API)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Generation settings
LLM_TEMPERATURE=0.4
# Maximum time to wait for an answer (in seconds)
LLM_TIMEOUT=30
