# Copier ce fichier en ".env" puis mettre la vraie clé dans .env
# Le fichier .env est ignoré par git : il ne doit jamais être publié.

# Fournisseur du modèle (API compatible OpenAI)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Paramètres de génération
LLM_TEMPERATURE=0.4
# Temps d'attente maximum d'une réponse (en secondes)
LLM_TIMEOUT=30
